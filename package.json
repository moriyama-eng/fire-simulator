{
  "name": "fire-monte-carlo-simulator",
  "version": "2.8.2",
  "description": "FIRE Monte Carlo Simulator",
  "type": "module",
  "bin": {
    "fire-sim": "./cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "simulate": "node cli.js",
    "build:css": "tailwindcss -c tailwind.config.cjs -i css/tailwind.src.css -o css/tailwind.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.cjs -i css/tailwind.src.css -o css/tailwind.css --minify --watch"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^1.6.0",
    "jsdom": "^24.1.0",
    "tailwindcss": "3.4.17",
    "vitest": "^1.6.0"
  }
}
